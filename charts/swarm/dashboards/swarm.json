    {
      "type": "stat",
      "title": "Since each job last succeeded",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - swarm_job_last_success_timestamp_seconds{repository=\"$repository\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 8,
        "h": 6
      },
      "id": 22
    },
