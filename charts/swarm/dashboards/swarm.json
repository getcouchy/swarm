{
  "title": "Swarm",
  "uid": "swarm",
  "description": "The agent swarm's housekeeping: who is ticking, what is locked, queued, in review and overdue. Metrics from getcouchy/swarm's sweep.mjs and reviewed.mjs (docs/metrics.md there); this file is charts/swarm/dashboards/swarm.json in that repository.",
  "tags": [
    "swarm"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {
          "text": "prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {
          "text": "loki",
          "value": "loki"
        }
      },
      {
        "name": "repository",
        "type": "query",
        "label": "Repository",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(swarm_job_last_success_timestamp_seconds, repository)",
          "refId": "repository"
        }
      },
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values({__name__=~\"swarm_.+\", repository=\"$repository\"}, agent)",
          "refId": "agent"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "refresh": 1,
        "description": "The namespace the chart's CronJobs run in, found from kube-state-metrics by the agent-sweep CronJob. It scopes the failed runs and the log panel.",
        "query": {
          "query": "label_values(kube_cronjob_info{cronjob=\"agent-sweep\"}, namespace)",
          "refId": "namespace"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Agents",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Since each agent last ticked",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 14400
              },
              {
                "color": "red",
                "value": 28800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - swarm_agent_last_tick_timestamp_seconds{repository=\"$repository\", agent=~\"$agent\"}",
          "legendFormat": "{{agent}}"
        }
      ],
      "description": "From each agent's heartbeat comment on the Agent desk. The colours assume the default 8 hour limit; the panel beside this one draws the limit the sweep ran with.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 6
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Since last tick, against the limit",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - swarm_agent_last_tick_timestamp_seconds{repository=\"$repository\", agent=~\"$agent\"}",
          "legendFormat": "{{agent}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max(swarm_limit_seconds{repository=\"$repository\", limit=\"heartbeat\"})",
          "legendFormat": "limit"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 6
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Locks held",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count by (agent) (swarm_lock_age_seconds{repository=\"$repository\", agent=~\"$agent\"})",
          "legendFormat": "{{agent}}"
        }
      ],
      "description": "Issues and pull requests carrying each agent's swarm/agent/<name> label.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Locks",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "number"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "targetBlank": true,
                    "url": "https://github.com/${repository:raw}/issues/${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Held for"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Held for",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "type": 0,
              "number": 1,
              "agent": 2,
              "Value": 3
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (type, number, agent) (swarm_lock_age_seconds{repository=\"$repository\", agent=~\"$agent\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "id": 5
    },
    {
      "id": 6,
      "type": "row",
      "title": "Queue",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Approved issues",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count(swarm_issues{repository=\"$repository\", state=\"claimable\"}) or vector(0)",
          "legendFormat": "claimable"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count(swarm_issues{repository=\"$repository\", state=\"locked\"}) or vector(0)",
          "legendFormat": "locked"
        }
      ],
      "description": "Claimable: approved and nobody has taken it. Blockers are not looked up, so a blocked issue counts as claimable.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Approved issues now",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "number"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "targetBlank": true,
                    "url": "https://github.com/${repository:raw}/issues/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "number": 0,
              "state": 1,
              "agent": 2
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (number, state, agent) (swarm_issues{repository=\"$repository\", agent=~\"$agent\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "id": 8
    },
    {
      "id": 9,
      "type": "row",
      "title": "Pull requests",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Pull requests by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count by (state) (swarm_pulls{repository=\"$repository\", agent=~\"$agent\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Pull requests now",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "number"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "targetBlank": true,
                    "url": "https://github.com/${repository:raw}/issues/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "number": 0,
              "state": 1,
              "agent": 2
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (number, state, agent) (swarm_pulls{repository=\"$repository\", agent=~\"$agent\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "The reviewed status",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count by (state) (swarm_reviewed_pulls{repository=\"$repository\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "description": "The required `reviewed` status on each open pull request's head.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "id": 12
    },
    {
      "type": "table",
      "title": "Not yet reviewed ok",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "number"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "targetBlank": true,
                    "url": "https://github.com/${repository:raw}/issues/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "number": 0,
              "state": 1
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (number, state) (swarm_reviewed_pulls{repository=\"$repository\", state!=\"success\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "id": 13
    },
    {
      "id": 14,
      "type": "row",
      "title": "Overdue",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Needs you",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count(swarm_overdue_age_seconds{repository=\"$repository\", kind=\"human\"}) or vector(0)",
          "legendFormat": "needs-human"
        }
      ],
      "description": "Open items carrying swarm/needs-human.",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 4,
        "h": 8
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Overdue by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count by (kind) (swarm_overdue_age_seconds{repository=\"$repository\", agent=~\"$agent\"})",
          "legendFormat": "{{kind}}"
        }
      ],
      "description": "What the Agent desk lists, by section. docs/metrics.md in getcouchy/swarm says what each kind is.",
      "gridPos": {
        "x": 4,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "id": 16
    },
    {
      "type": "table",
      "title": "Overdue now",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "number"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on GitHub",
                    "targetBlank": true,
                    "url": "https://github.com/${repository:raw}/issues/${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "For"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "For",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "kind": 0,
              "number": 1,
              "agent": 2,
              "Value": 3
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (kind, number, agent) (swarm_overdue_age_seconds{repository=\"$repository\", agent=~\"$agent\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "id": 17
    },
    {
      "id": 18,
      "type": "row",
      "title": "Handoffs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Handed to a person, per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (agent, type) (increase(swarm_needs_human_total{repository=\"$repository\", agent=~\"$agent\"}[1h]))",
          "legendFormat": "{{agent}} {{type}}"
        }
      ],
      "description": "Times swarm/needs-human went onto an issue or pull request, by the agent it was with.",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 7
      },
      "id": 19
    },
    {
      "type": "timeseries",
      "title": "Held from merging, per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (agent) (increase(swarm_hold_total{repository=\"$repository\", agent=~\"$agent\"}[1h]))",
          "legendFormat": "{{agent}}"
        }
